<?php
declare(strict_types=1);

/**
 * Copiază ca config/mail.local.php pe server (sau setează variabilele în Plesk → PHP).
 * Nu comite mail.local.php în Git.
 *
 * Variabile de mediu recomandate pe Plesk:
 *   SMTP_PASSWORD=parola_mailbox_contact
 *   (opțional) SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_ENCRYPTION
 */

if (!defined('SMTP_PASSWORD')) {
    define('SMTP_PASSWORD', 'PAROLA_MAILBOX_contact@alinabradu.com');
}

